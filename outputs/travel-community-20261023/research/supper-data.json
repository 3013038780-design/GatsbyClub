    "content": {
      "data": {
        "intro": {
          "tagline": "Membership",
          "headline": "Join the Party",
          "body": "Extraordinary experiences, memorable conversations and authentic connections: The only way to tap into everything The Supper Club offers is through membership. Becoming a member unlocks access to bespoke events centered around food, music, drink and design, as well as weekend getaways sure to invigorate and inspire. Explore the membership tiers below."
        },
        "memberships": [
          {
            "membership": 6,
            "name": "VIP",
            "description": "Our elite national membership tier offers exclusive access to our nationwide Secret Supper Series, unlimited access to all events nationwide, global trips, invitations to every pre-launch event in new TSC cities and priority inclusion for guests at events. VIP members also enjoy dinner bookings with our nationwide restaurant partners (we’ll pick up the check), special access to third-party film, fashion, culture and arts events; and bespoke gifts delivered to your door – plus all the dinner parties, cocktail soirées, themed nights, weekend getaways you already know and love.",
            "note": null,
            "image": {
              "name": " The-Supper-Club-Private-Members-Club-VIP-Membership.jpg",
              "type": "image",
              "code": "iienqavvcvmhbt1odckr",
              "thumbnail": "https://res.cloudinary.com/dknwhnbg4/image/upload/w_240,h_240,c_limit/v1679510435/iienqavvcvmhbt1odckr.jpg",
              "url": "https://res.cloudinary.com/dknwhnbg4/image/upload/v1679510435/iienqavvcvmhbt1odckr.jpg"
            },
            "events": null,
            "cities": "Worldwide",
            "attend": "Unlimited Events"
          },
          {
            "membership": 7,
            "name": "VIP Local",
            "description": "The local adaptation of our elite VIP tier, this membership offers access to VIP Suppers, unlimited access to events in your state, and priority inclusion of first-time guests when space allows.",
            "note": null,
            "image": {
              "name": " The-Supper-Club-Private-Members-Club-Gold-Membership.jpg",
              "type": "image",
              "code": "aefrihn2uch3ntnr9ayg",
              "thumbnail": "https://res.cloudinary.com/dknwhnbg4/image/upload/w_240,h_240,c_limit/v1679511185/aefrihn2uch3ntnr9ayg.jpg",
              "url": "https://res.cloudinary.com/dknwhnbg4/image/upload/v1679511185/aefrihn2uch3ntnr9ayg.jpg"
            },
            "events": null,
            "cities": "1 State",
            "attend": "Unlimited events"
          },
          {
            "membership": 4,
            "name": "Silver",
            "description": "Our local membership level includes unlimited attendance at events in the state chapter of the Silver member’s choice. Members in this tier can look forward to invitations to dinner parties, cocktail soirées, themed nights– and all the other entrancing events that are our specialty.",
            "note": null,
            "image": {
              "name": "Supper Club 20 Jan 2022 Seaspice  (154).jpg",
              "type": "image",
              "code": "piustlz9dpfib0ctvxlc",
              "thumbnail": "https://res.cloudinary.com/dknwhnbg4/image/upload/w_240,h_240,c_limit/v1679515650/piustlz9dpfib0ctvxlc.jpg",
              "url": "https://res.cloudinary.com/dknwhnbg4/image/upload/v1679515650/piustlz9dpfib0ctvxlc.jpg"
            },
            "events": null,
            "cities": "1 State",
            "attend": "Unlimited events"
          },
          {
            "membership": 3,
            "name": "Explorer",
            "description": "Our traveling membership offers select access to events in every TSC city chapter nationwide. Explorer members may attend up to eight events per year.",
            "note": null,
            "image": {
              "name": "The Supper Club Inc 7 April 2021  (186).jpg",
              "type": "image",
              "code": "djyyw5z1vh3w5uxdk0ex",
              "thumbnail": "https://res.cloudinary.com/dknwhnbg4/image/upload/w_240,h_240,c_limit/v1681839139/djyyw5z1vh3w5uxdk0ex.jpg",
              "url": "https://res.cloudinary.com/dknwhnbg4/image/upload/v1681839139/djyyw5z1vh3w5uxdk0ex.jpg"
            },
            "events": null,
            "cities": "Nationwide",
            "attend": "8 Events"
          },
          {
            "membership": 2,
            "name": "Young Professsional",
            "description": "A local membership designed for members aged 27 and under, our Young Professional level offers all the benefits of a Silver membership at a reduced rate. YP members can look forward to unlimited access to events in their state chapter, including dinner parties, cocktail soirées, themed nights, weekend getaways – and all the other entrancing events that are our specialty.",
            "note": null,
            "image": {
              "name": "SCAVRA-91.png",
              "type": "image",
              "code": "ii2zrzrr73ocbdhcoh8n",
              "thumbnail": "https://res.cloudinary.com/dknwhnbg4/image/upload/w_240,h_240,c_limit/v1736291497/ii2zrzrr73ocbdhcoh8n.png",
